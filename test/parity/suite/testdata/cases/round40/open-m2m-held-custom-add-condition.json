       "resource": {
        "id": "r40",
        "c": "n"
       },
       "type": "PARITY_SUITE_R40ACO_R40OPENM2MHELDCUSTOMADDCONDITION_CONTROL_FIRST"
      }
     ]
    }
   ]
  },
