    }
   ],
   "customize": [
    {
     "name": "replace",
     "level": "CUSTOMER",
     "sets": [
      {
       "key": "set",
       "policies": [
        {
         "key": "reader",
         "rules": [
          {
           "key": "allow",
           "name": "customized allow",
           "target": "true",
           "condition": "resource.a == 'y'",
           "effect": "ALLOW"
          }
         ]
        }
       ]
      }
     ],
     "requests": [
      {
       "name": "after-read-a-y",
       "resource": {
        "id": "r40",
        "a": "y"
       },
