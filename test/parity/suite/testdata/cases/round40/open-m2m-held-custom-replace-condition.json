   "pips": [
    "held"
   ],
   "about": "An ACTIVE top-level set whose only rule allows on resource.a == 'y' OR subject.parityR40HeldReplaceCondition == 'v'; before the customization every request answers 400. A CUSTOMER customization replaces the rule with one that allows on resource.a == 'y' and does not name the GENERAL. after-read-a-y and after-read-other answer 400 if the tenant holds the uploaded condition; true if it holds the conditions the customizations make. The runner deletes the customization after the case, so the last control answers 400 under both readings.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow",
         "target": "true",
         "condition": "resource.a == 'y' OR subject.parityR40HeldReplaceCondition == 'v'",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "before-read-a-y",
     "resource": {
      "id": "r40",
      "a": "y"
     },
