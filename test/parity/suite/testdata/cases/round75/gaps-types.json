  {
   "id": "g75-types-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand fails every check.",
   "resourceType": "PARITY_SUITE_G75_TYPES_CONTROL_FIRST",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == 'PARITY_SUITE_G75_TYPES_CONTROL_FIRST'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "probe",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r75",
      "c": "n"
     }
    }
   ]
  },
