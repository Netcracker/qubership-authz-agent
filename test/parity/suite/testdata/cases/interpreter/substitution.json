   "id": "substitution-subject-roles",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "list",
         "target": "operation == 'LIST'",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "a==${subject.roles}",
          "sqlPredicate": "a=${subject.roles}",
          "mongodbPredicate": "{ \"a\": ${subject.roles} }",
          "predicate": "${resourceType}.a.eq(${subject.roles})",
          "customPredicate": {
           "predicate": "a:${p}",
           "params": {
            "p": "subject.roles"
           }
          }
         }
        }
       ]
      }
     ]
    }
   ],
