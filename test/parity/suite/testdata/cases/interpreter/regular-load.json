     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "read-allow",
         "target": "operation == 'READ'",
         "condition": "subject.isM2M == true",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    }
   ],
