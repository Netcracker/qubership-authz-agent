   "claim": "$.department",
   "cacheable": false
  },
  "roles-path": {
   "name": "subject.parityTkRoles",
   "type": "UUID",
   "pipType": "TOKEN",
   "claim": "$.realm_access.roles",
   "cacheable": false
  },
  "by-id": {
   "name": "subject.permissions.PARITY_MK1",
   "type": "UUID",
   "pipType": "MAPPING",
   "cacheable": false,
   "customMapping": {
    "subject.id": {
     "00000000-0000-0000-0000-000000000101": [
      "parity_by_id"
     ]
    }
   }
  },
  "department": {
   "name": "subject.parityMkDepartment",
   "type": "UUID",
   "pipType": "TOKEN",
   "claim": "department",
   "cacheable": false
  },
  "by-department": {
   "name": "subject.permissions.PARITY_MK2",
   "type": "UUID",
   "pipType": "MAPPING",
   "cacheable": false,
   "customMapping": {
    "subject.parityMkDepartment": {
     "finance": [
      "parity_by_department"
     ]
    }
   }
  },
  "by-other-role": {
   "name": "subject.permissions.PARITY_MK3",
   "type": "UUID",
   "pipType": "MAPPING",
   "cacheable": false,
   "customMapping": {
    "subject.roles": {
     "ROLE_PARITY_OTHER": [
      "parity_by_other_role"
     ]
    }
   }
  }
 },
