 "cases": [
  {
   "id": "set-target-reads-service",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}' AND resource.service == 'parity-st-svc'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "read",
         "target": "operation == 'READ'",
         "condition": "true",
         "effect": "ALLOW"
        },
        {
         "key": "list",
         "target": "operation == 'LIST'",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "st==1"
         }
        }
       ]
      }
     ]
    },
    {
     "key": "sibling",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "sibling-reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "read-when-s",
         "target": "operation == 'READ'",
         "condition": "resource.s == 'y'",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
