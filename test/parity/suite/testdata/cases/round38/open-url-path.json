 "cases": [
  {
   "id": "r38openurlpath-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r38",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "r38open-url-id-path",
   "pips": [
    "r38open-url-id-path"
   ],
   "about": "The url ends in r38open-url-id-path-${subject.id.x}, a path after the builtin id. The upload is refused (400) if the url list is matched on the whole placeholder, and accepted if it is matched on the part before the first dot, since a url takes subject.id. If it is accepted, the route r38open-url-id-path-null answers v, so a = n is true when the placeholder becomes the text null; the route r38open-url-id-path- answers w, so a = n is false and a = y true when it becomes empty; the route r38open-url-id-path-00000000-0000-0000-0000-000000000101 answers u, so a = n is false and a = y true when the path is dropped and the builtin's value stays; a placeholder left as written fails the call, so both are false. pipCalls of a = n counts the calls to the -null route, pipCalls of a = y the calls to the route r38open-url-id-path-00000000-0000-0000-0000-000000000101, which tells the last readings apart.",
   "condition": "subject.parityR38UrlIdPath == 'v' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r38",
      "a": "n"
     },
     "pipCalls": "/api/v1/pip/r38open-url-id-path-null"
    },
    {
     "name": "read-a-y",
     "resource": {
      "id": "r38",
      "a": "y"
     },
     "pipCalls": "/api/v1/pip/r38open-url-id-path-00000000-0000-0000-0000-000000000101"
    }
   ]
  },
  {
   "id": "r38openurlpath-control-last",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
