   "pips": [
    "scope",
    "r38open-ra-scope-key-declared"
   ],
   "about": "The upload declares the PERMISSION_SCOPE PIP subject.permissionScope, and requestAttributes.x is ${subject.permissionScope.region}, a key of a grant. A whole ${subject.permissionScope} over the declared PIP is refused by the kind check (r37open-ra-scope-declared). The upload is refused (400) whether the key is looked up with its path, as no declared name, or without it, as the PERMISSION_SCOPE kind; the stand's log tells the two apart.",
   "condition": "subject.parityR38RaScopeKey == 'v' OR resource.a == 'y'",
