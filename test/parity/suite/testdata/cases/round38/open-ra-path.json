 "cases": [
  {
   "id": "r38openrapath-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r38",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "r38open-ra-id-path",
   "pips": [
    "r38open-ra-id-path"
   ],
   "about": "requestAttributes.x is ${subject.id.x}, a path after id, which a whole value takes (round 37). The upload is taken if the check matches the part before the first dot, and refused (400) if it matches the whole placeholder, which is no declared name. Taken, the call carries null if the path selects nothing in the builtin's value; the value of subject.id if the path is dropped; the text as written if a placeholder with a path is not substituted.",
   "condition": "subject.parityR38RaIdPath == 'v' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r38",
      "a": "n"
     },
     "pipCalls": "/api/v1/pip/r38open-ra-id-path"
    },
    {
     "name": "read-a-y",
     "resource": {
      "id": "r38",
      "a": "y"
     }
    }
   ]
  },
  {
   "id": "r38open-ra-permissions-path",
   "pips": [
    "r38open-ra-permissions-path"
   ],
   "about": "requestAttributes.x is ${subject.permissions.x}, a path after permissions, which a whole value refuses as an undeclared name (round 36). The upload is refused (400) whether the check matches the whole placeholder or the part before the first dot.",
   "condition": "subject.parityR38RaPermissionsPath == 'v' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r38",
