  {
   "id": "f72-inactive-deny-pred",
   "about": "An active policy whose ALLOW rule has no predicate beside an INACTIVE DENY_OVERRIDES policy whose DENY rule carries the predicate fd==4, under DENY_OVERRIDES; the filter, then check/resource of a row with fd = 4 and one with fd = 1. Does the filter read the INACTIVE policy's DENY rule as one without a predicate (DENY), read its predicate (fd!=4), or leave the policy out (ALLOW)?",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_OVERRIDES",
     "policies": [
      {
       "key": "active",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW"
        }
       ]
      },
      {
       "key": "inactive",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_OVERRIDES",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "fd==4",
          "sqlPredicate": "fd=4",
          "predicate": "${resourceType}.fd.eq(4)",
          "mongodbPredicate": "{ \"fd\": 4 }"
         }
        }
       ],
       "fields": {
        "status": "INACTIVE"
       }
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true,
     "operation": "READ"
    },
    {
     "name": "row-1",
     "operation": "READ",
     "resource": {
      "id": "row-1",
      "fd": 4
     }
    },
    {
     "name": "row-2",
     "operation": "READ",
     "resource": {
      "id": "row-2",
      "fd": 1
     }
    }
   ]
  },
