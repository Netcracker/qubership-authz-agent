  {
   "id": "g72-ob-token-default",
   "about": "Two TOKEN PIPs with the defaultValue parity-g72-default: subject.parityG72Department over the claim department, which the reader's token holds (finance), and subject.parityG72Absent over a claim no token holds. A DENY_UNLESS_PERMIT rule `<pip> CONTAINS 'parity-g72-default' OR resource.a == 'y'` for each, decided for another user (userId, the lookup finds the user) and for the reader, a = n and a = y. On behalf of a user the token's claims are empty: the defaultValue makes both rules true, the empty collection the documentation promises makes them false for a = n. For the reader the absent claim takes the defaultValue (true) and department reads finance (false).",
   "resourceType": "PARITY_SUITE_G72_OB_TOKEN_DEFAULT",
   "tenant": "parity-g72-ob-token-default",
   "steps": [
    {
     "name": "declare",
     "op": "write-domain-pips",
     "args": {
      "domain": "PARITY_ISOLATED"
     },
     "observe": [
      "status",
      "error-class"
     ],
     "onRefusal": "continue",
     "body": [
      {
       "name": "subject.parityG72Department",
       "type": "UUID",
       "pipType": "TOKEN",
       "claim": "department",
       "cacheable": false,
       "defaultValue": "parity-g72-default"
      },
      {
       "name": "subject.parityG72Absent",
       "type": "UUID",
       "pipType": "TOKEN",
       "claim": "parityG72Absent",
       "cacheable": false,
       "defaultValue": "parity-g72-default"
      }
     ]
    },
    {
     "name": "upload",
     "op": "write-external-id-sets",
     "args": {
      "externalId": "parity-g72-ob-token-default"
     },
     "observe": [
      "status",
      "error-class",
      "decide:dept-as-a-user-a-n",
      "decide:dept-as-a-user-a-y",
      "decide:dept-as-self-a-n",
      "decide:dept-as-self-a-y",
      "decide:absent-as-a-user-a-n",
      "decide:absent-as-a-user-a-y",
      "decide:absent-as-self-a-n",
      "decide:absent-as-self-a-y"
     ],
     "onRefusal": "continue",
     "body": [
      {
       "policySetId": "a757cbfb-760f-a0a8-e0eb-2cfe62208a3e",
       "name": "g72-ob-token-default set",
       "status": "ACTIVE",
       "target": "resourceType == 'PARITY_SUITE_G72_OB_TOKEN_DEFAULT'",
       "policies": [
        {
         "policyId": "8dc7b79f-1f02-6461-3745-f74220152cae",
         "name": "g72-ob-token-default reader",
         "target": "true",
         "rules": [
          {
           "ruleId": "c1153a3f-70e9-4ac0-fa19-52970c7d36e2",
           "name": "g72-ob-token-default dept",
           "target": "resource.p == 'dept'",
           "condition": "subject.parityG72Department CONTAINS 'parity-g72-default' OR resource.a == 'y'",
           "effect": "ALLOW"
          },
          {
           "ruleId": "5947ff24-842d-d297-7d9e-89004a3ca350",
           "name": "g72-ob-token-default absent",
           "target": "resource.p == 'absent'",
