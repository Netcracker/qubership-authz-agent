  {
   "id": "g72-ob-check-source-500",
   "about": "The rule that allows VIEW_AS_ANOTHER_USER reads `subject.parityG72AuthSource == 'y'`, a GENERAL PIP whose source answers 500. r32gaps-on-behalf-http-500-* failed the same check by an evaluation error (an iterate over scope values that are plain strings) and answered 500; here the check fails by its source. A request with userId answers 500 if any failure of the check fails the request, false (no item) if a failed source only makes the rule not apply. The direct check of VIEW_AS_ANOTHER_USER asks the same failure without a lookup; the request without userId is the control, true.",
   "resourceType": "PARITY_SUITE_G72_OB_CHECK_SOURCE_500",
   "tenant": "parity-g72-ob-check-source-500",
   "steps": [
    {
     "name": "declare",
     "op": "write-domain-pips",
     "args": {
      "domain": "PARITY_ISOLATED"
     },
     "observe": [
      "status",
      "error-class"
     ],
     "onRefusal": "continue",
     "body": [
      {
       "name": "subject.parityG72AuthSource",
       "pipType": "GENERAL",
       "httpMethod": "POST",
       "cacheable": false,
       "url": "http://pip-mock:8090/api/v1/pip/g72-auth-source",
       "requestAttributes": {
        "case": "g72-auth-source"
       }
      }
     ]
    },
