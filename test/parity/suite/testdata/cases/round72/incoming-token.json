{
 "about": "Round 72: does legacy verify Incoming-Token? Each case sends one token the builder wrote, in the request's own headers beside the M2M token; the first case is the control with a token of the stand's Keycloak. Default tenant.",
 "resourceTypePrefix": "PARITY_SUITE_",
 "standVersion": true,
 "cases": [
  {
   "id": "i72-token-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r33",
      "c": "n"
     }
    }
   ]
  },
