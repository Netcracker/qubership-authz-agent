     "args": {
      "externalId": "parity-o72-jp-regex-spaces"
     },
     "observe": [
      "status",
      "error-class",
      "decide:space-a-n",
      "decide:space-a-y",
      "decide:zero-a-n",
      "decide:zero-a-y",
      "decide:other-a-n",
      "decide:other-a-y"
     ],
     "onRefusal": "continue",
     "body": [
