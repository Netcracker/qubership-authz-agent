  {
   "id": "rt69-spaces",
   "about": "The request type with a space at each end, against two sets: one whose target names the type (resourceType == '<type>', its predicates read the attribute a) and one whose target names it with the same spaces (resourceType == ' <type> ', attribute b). Which attribute appears says whether the type is trimmed before the targets compare it; the text after a or b says whether the substitution carries the spaces.",
   "sets": [
    {
     "key": "exact",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "exact-reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "exact-allow",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "predicate": "${resourceType}.a.eq(\"${subject.id}\")",
          "rsqlPredicate": "a==${resourceType}",
          "sqlPredicate": "a='${resourceType}'",
          "mongodbPredicate": "{ \"a\": \"${resourceType}\" }"
         }
        }
       ]
      }
     ]
    },
    {
     "key": "spaced",
     "target": "resourceType == ' {{resourceType}} '",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "spaced-reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "spaced-allow",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "predicate": "${resourceType}.b.eq(\"${subject.id}\")",
          "rsqlPredicate": "b==${resourceType}",
          "sqlPredicate": "b='${resourceType}'",
          "mongodbPredicate": "{ \"b\": \"${resourceType}\" }"
         }
        }
       ]
      }
     ]
    }
