    "gUnicode"
   ],
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_OVERRIDES",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_OVERRIDES",
       "rules": [
        {
         "key": "rule",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "a==${subject.permissions}",
          "sqlPredicate": "a=${subject.permissions}",
          "predicate": "${resourceType}.a.eq(${subject.permissions})",
          "mongodbPredicate": "{ \"a\": ${subject.permissions} }"
         }
        }
       ]
      }
     ]
    }
   ],
