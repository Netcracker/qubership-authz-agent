   "id": "op69-parens-deny-and",
   "about": "A DENY_OVERRIDES policy with an ALLOW rule whose predicate is fa==1 and two DENY rules whose predicates are fb==2;fc==3 and fd==4, in every dialect: the filter joins the negated DENY predicates to the ALLOW side. Its rsql negation fb!=2,fc!=3 is an OR inside an AND: is it parenthesised, or joined as written so that the AND binds fc!=3 alone?",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_OVERRIDES",
       "rules": [
        {
         "key": "allow",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "fa==1",
          "sqlPredicate": "fa=1",
          "predicate": "${resourceType}.fa.eq(1)",
          "mongodbPredicate": "{ \"fa\": 1 }"
         }
        },
        {
         "key": "deny-first",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "fb==2;fc==3",
          "sqlPredicate": "fb=2 AND fc=3",
          "predicate": "${resourceType}.fb.eq(2).and(${resourceType}.fc.eq(3))",
          "mongodbPredicate": "{ \"fb\": 2, \"fc\": 3 }"
         }
        },
        {
         "key": "deny-second",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "fd==4",
          "sqlPredicate": "fd=4",
          "predicate": "${resourceType}.fd.eq(4)",
          "mongodbPredicate": "{ \"fd\": 4 }"
         }
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true,
     "operation": "READ"
    },
    {
     "name": "read",
     "resource": {
      "id": "r33"
     }
    }
   ]
