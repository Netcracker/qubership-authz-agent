   "id": "fs69-c-set-algorithm-permit-unless-deny-over-allow-and-deny-predicates",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "allows",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "list-allow-with-a-predicate",
         "target": "operation == 'LIST'",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "allowed==1"
         }
        }
       ]
      },
      {
       "key": "denies",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_OVERRIDES",
       "rules": [
        {
         "key": "list-deny-with-a-predicate",
         "target": "operation == 'LIST'",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "blocked==1"
         }
        }
       ]
      }
     ]
    }
   ],
   "requests": [
