{
 "about": "A policy with status INACTIVE beside an active one in a plain set, asked through check/filter and check/resource in one case: the filter may leave the INACTIVE policy out while the check reads no policy status. A twin with both policies active shows that the second policy reaches the filter. A sequence case in a tenant of its own assigns an empty mapping to a role. Controls first and last must answer true.",
 "resourceTypePrefix": "PARITY_SUITE_R67_OPEN_",
 "standVersion": true,
 "cases": [
  {
   "id": "op67-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r33",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "op67-inactive-policy-allow",
   "about": "An active policy whose ALLOW rule carries fa==1 beside an INACTIVE policy whose ALLOW rule carries fb==2, under PERMIT_OVERRIDES: does the filter read the INACTIVE policy?",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_OVERRIDES",
     "policies": [
      {
       "key": "active",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "fa==1",
          "sqlPredicate": "fa=1",
          "predicate": "${resourceType}.fa.eq(1)",
          "mongodbPredicate": "{ \"fa\": 1 }"
         }
        }
       ]
      },
      {
       "key": "second",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow-b",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "fb==2",
          "sqlPredicate": "fb=2",
          "predicate": "${resourceType}.fb.eq(2)",
          "mongodbPredicate": "{ \"fb\": 2 }"
         }
        }
       ],
       "fields": {
        "status": "INACTIVE"
       }
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true,
     "operation": "READ"
    },
    {
     "name": "read",
     "resource": {
      "id": "r33"
     }
    }
   ]
  },
