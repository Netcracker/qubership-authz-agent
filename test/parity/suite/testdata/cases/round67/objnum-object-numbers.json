{
 "about": "Two objects of resource attributes compared under == and under !=: one number spelled two ways (1 and 1.0, 1.0 and 1.00, 1e2 and 100.0), a number against the string of its text, a string in two cases, and an object inside a list. The == case and its != twin together tell equal, not equal and a failed comparison apart. A positive control compares an object with itself. Controls first and last must answer true.",
 "resourceTypePrefix": "PARITY_SUITE_R67_OBJNUM_",
 "standVersion": true,
 "cases": [
  {
   "id": "on67-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r33",
      "c": "n"
     }
    }
   ]
  },
