   }
  }
 },
 "cases": [
  {
   "id": "r35gaps-request-attributes-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r35",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "r35gaps-request-attribute-list",
   "pips": [
    "list"
   ],
   "about": "requestAttributes.l is the list [\"${subject.id}\", \"x\"]. The call carries the reader's id in its place if a list is substituted element by element; the text ${subject.id} if only text values are.",
   "condition": "subject.parityR35RaList == 'v' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r35",
      "a": "n"
     },
