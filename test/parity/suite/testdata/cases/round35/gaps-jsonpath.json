{
 "about": "Resource paths no golden has run to the end: a function over a value it does not apply to, a union and a slice after [*] where the star selects a text beside a list, an existence filter beside a text, and a filter that orders a number against a text literal. Each probe is `<comparison> OR resource.a == 'y'` with a = n and a = y: true, false, or the end of the rule, which makes both false.",
 "resourceTypePrefix": "PARITY_SUITE_R35G_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "r35gaps-jsonpath-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r35",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "r35gaps-jp-first-of-an-object",
   "about": "resource.o is the object {\"k\": \"v\"}. a = n true if first() of an object is its first value; both false if first() applies to a list only and the path fails.",
   "condition": "resource.o.first() == 'v' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r35",
      "a": "n",
      "o": {
       "k": "v"
      }
     }
    },
    {
     "name": "read-a-y",
     "resource": {
      "id": "r35",
      "a": "y",
      "o": {
       "k": "v"
      }
     }
    }
   ]
  },
  {
