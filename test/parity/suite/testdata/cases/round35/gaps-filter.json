   "id": "r35gaps-filter-custom-one-part",
   "about": "One policy with two ALLOW rules: one with rsqlPredicate f6==v alone, one with a customPredicate alone. customFilterCondition's logic is the custom rule's path alone if an OR with one custom part collapses to it; the OR with that one part if it does not.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "allow",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow-rsql",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "f6==v"
         }
        },
        {
         "key": "allow-custom",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "customPredicate": {
           "predicate": "[{\"value\":${p},\"property\":\"f6\",\"operator\":\"in\"}]",
           "params": {
            "p": "subject.roles"
           }
          }
         }
        }
       ]
      }
     ]
    }
