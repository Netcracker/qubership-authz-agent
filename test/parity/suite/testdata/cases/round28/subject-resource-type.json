  {
   "id": "r28subj-rt-01",
   "about": "The resource type is \"PARITY_SUITE_R28T_01_x\\\"}, {\\\"b\\\": 1\".",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == 'PARITY_SUITE_R28T_01_x\"}, {\"b\": 1'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "r",
         "target": "operation == 'LIST'",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "t==${resourceType}",
          "sqlPredicate": "t=${resourceType}",
          "mongodbPredicate": "{ \"t\": ${resourceType} }",
          "predicate": "x.t.eq(${resourceType})"
         }
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true,
     "type": "PARITY_SUITE_R28T_01_x\"}, {\"b\": 1"
    },
    {
     "name": "check-list",
     "operation": "LIST",
     "type": "PARITY_SUITE_R28T_01_x\"}, {\"b\": 1",
     "resource": {
      "id": "r28"
     }
    }
   ]
