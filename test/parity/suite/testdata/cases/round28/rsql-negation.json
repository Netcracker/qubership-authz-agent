{
 "about": "How check/filter writes a DENY predicate under DENY_OVERRIDES and PERMIT_UNLESS_DENY when the predicate is more than one ==: an operator of each family, bare and quoted; ; and , inside one predicate; a group; a quoted literal holding ==, a comma or a semicolon. Each case has one DENY rule with the predicate in rsql, sql, querydsl and mongodb where the form has one, and one filter request. Controls: blocked==1, whose negation the goldens show as blocked!=1.",
 "resourceTypePrefix": "PARITY_SUITE_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "r28rsql-negation-control-first",
   "about": "Control: a DENY rule blocked==1 under PERMIT_UNLESS_DENY; the goldens show blocked!=1.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "rule",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "blocked==1",
          "sqlPredicate": "blocked=1",
          "predicate": "${resourceType}.blocked.eq(1)",
          "mongodbPredicate": "{ \"blocked\": 1 }"
         }
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true
    }
   ]
  },
  {
   "id": "r28rsql-do-join-a-eq-1-or-b-eq-2-and-c-eq-3",
   "about": "A DENY rule under DENY_OVERRIDES with the predicate (a==1,b==2);c==3. The filter shows how each dialect negates it; tells apart: rsql negation both joins, rsql negation tree.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_OVERRIDES",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_OVERRIDES",
       "rules": [
        {
         "key": "rule",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "(a==1,b==2);c==3",
          "sqlPredicate": "(a=1 OR b=2) AND c=3",
          "predicate": "((${resourceType}.a.eq(1)).or(${resourceType}.b.eq(2))).and(${resourceType}.c.eq(3))",
          "mongodbPredicate": "{ \"$and\": [ { \"$or\": [ { \"a\": 1 }, { \"b\": 2 } ] }, { \"c\": 3 } ] }"
         }
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true
    }
   ]
  },
