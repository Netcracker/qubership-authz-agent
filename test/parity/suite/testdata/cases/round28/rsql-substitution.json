 "cases": [
  {
   "id": "r28rsql-substitution-control-first",
   "about": "Control: a DENY rule blocked==1 under PERMIT_UNLESS_DENY; the goldens show blocked!=1.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "rule",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "blocked==1",
          "sqlPredicate": "blocked=1",
          "predicate": "${resourceType}.blocked.eq(1)",
          "mongodbPredicate": "{ \"blocked\": 1 }"
         }
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true
    }
   ]
  },
