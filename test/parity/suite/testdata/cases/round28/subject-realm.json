     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "r",
         "target": "operation == 'LIST'",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "rsqlPredicate": "t==${subject.id};n==${subject.name}",
          "sqlPredicate": "t=${subject.id} AND n=${subject.name}",
          "mongodbPredicate": "{ \"t\": ${subject.id}, \"n\": ${subject.name} }",
          "predicate": "x.t.eq(${subject.id}).and(x.n.eq(${subject.name}))",
          "customPredicate": {
           "predicate": "t:${i};n:${n}",
           "params": {
            "i": "subject.id",
