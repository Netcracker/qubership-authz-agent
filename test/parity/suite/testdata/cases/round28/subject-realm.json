{
 "about": "How the subject's id and name enter a filter predicate and a GENERAL PIP's url when they hold characters the filter dialects or a URL reserve. The requests name users the parity realm has only after subject-realm-users.json is added to it; each request states the sub and preferred_username claims its token must carry, and the suite fails before sending it when the token carries others. For each user: a control that subject.id and subject.name are those values; a filter whose predicates read ${subject.id} and ${subject.name} in all four dialects and in a customPredicate; and a GENERAL PIP whose url ends with ${subject.id}, routed as in subject-url.json.",
 "resourceTypePrefix": "PARITY_SUITE_R28S_",
 "pins": {
  "/api/v1/pip/r28s/x' OR '1'='1": {
   "statusCode": 200,
   "body": [
    "s-m1"
   ]
  },
  "/api/v1/pip/r28s/x'+OR+'1'='1": {
   "statusCode": 200,
   "body": [
    "s-m2"
   ]
  },
  "/api/v1/pip/r28s/x\\y": {
   "statusCode": 200,
   "body": [
    "s-m3"
   ]
  },
  "/api/v1/pip/r28s/x y": {
   "statusCode": 200,
   "body": [
    "s-m4"
   ]
  },
  "/api/v1/pip/r28s/x+y": {
   "statusCode": 200,
   "body": [
    "s-m5"
   ]
  },
  "/api/v1/pip/r28s/r28#x": {
   "statusCode": 200,
   "body": [
    "s-m6"
   ]
  },
  "/api/v1/pip/r28s/r28": {
   "statusCode": 200,
   "body": [
    "s-m7"
   ]
  },
  "/api/v1/pip/r28s/r28?x": {
   "statusCode": 200,
   "body": [
    "s-m8"
   ]
  }
 },
 "pips": {
  "url": {
   "name": "subject.parityR28SubjectUrl",
   "pipType": "GENERAL",
   "httpMethod": "POST",
   "cacheable": false,
