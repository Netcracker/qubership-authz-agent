{
 "about": "Requests and nodes whose default reading no golden checked: an anonymous request that also carries the reader's end-user token, a user of the realm with no roles, a policy and a nested set whose target is JSON null (sent through the fields object, which the runner copies over the node's wire form), and check/filter with an empty operation parameter.",
 "resourceTypePrefix": "PARITY_SUITE_R29S_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "r29gaps-filter-with-an-empty-operation",
   "about": "A simplified policy for READ without a condition. check/filter with operation= (empty): ALLOW if an empty operation means READ, DENY if it is an operation no policy names; operation READ is the control.",
   "requests": [
    {
     "name": "filter-empty",
     "filter": true,
     "emptyOperation": true
    },
    {
     "name": "filter-read",
     "filter": true,
     "operation": "READ"
    }
   ]
  },
  {
   "id": "r29gaps-sets-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "c": "n",
      "id": "r29"
     }
    }
   ]
  },
  {
   "id": "r29gaps-anonymous-with-an-end-user-token-user",
   "about": "Authorization-Type: anonymous beside the reader's Incoming-Token. subject.type == 'USER' is true for a-n if the subject is the end user.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "any",
       "target": "true",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow",
         "target": "true",
         "condition": "subject.type == 'USER' OR resource.a == 'y'",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "a-n",
