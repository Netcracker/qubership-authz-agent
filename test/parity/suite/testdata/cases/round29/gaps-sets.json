  {
   "id": "r29gaps-user-without-roles",
   "about": "parity-anon-baseline has no realm role of the suite. True for a-n if its roles read as an empty collection; the rule ends if they read as absent. A token that carries Keycloak's default roles answers false too.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "any",
       "target": "true",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow",
         "target": "true",
         "condition": "subject.roles IS EMPTY OR resource.a == 'y'",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "a-n",
     "resource": {
      "a": "n",
      "id": "r29"
