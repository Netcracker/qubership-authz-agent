{
 "about": "A customization that replaces an ALLOW rule's effect with DENY, NOT_APPLICABLE, USE_FILTER_CONDITION, or text no effect has. The expected reading takes every effect but ALLOW and DENY as DENY, in an uploaded rule and in a customized one alike. The rule sits alone under PERMIT_UNLESS_DENY with rsqlPredicate p==1: read after is false if the new effect denies, true if the rule no longer applies or allows; the filter tells a deny term (the negated predicate), no term, and an allow term.",
 "resourceTypePrefix": "PARITY_SUITE_R29FD_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "r29fields-custom-effect-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ],
     "status": "ACTIVE"
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r29",
      "c": "n"
     }
    }
   ]
  },
