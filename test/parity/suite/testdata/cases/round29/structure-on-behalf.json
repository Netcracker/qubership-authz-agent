{
 "about": "check/resource and check/filter with the query parameter userId. The expected reading: the caller must be allowed VIEW_AS_ANOTHER_USER on resource type OnBehalfOfUserAuthorization, else false and DENY; then access-control reads the user from the User Management API and decides as that user. The resource set allows READ to anyone. With no authorization set, then with one that authorizes the M2M client, then with one that authorizes the reader as well (the earlier case's set stays loaded). userId names the reader itself, an id no user has, and the empty string. Without a User Management API on the stand, a lookup that runs fails: 500 or false.",
 "resourceTypePrefix": "PARITY_SUITE_R29ST_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "r29structure-on-behalf-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r29",
      "c": "n"
     }
    }
   ]
  },
