{
 "about": "Policies for the user interface. A simplified policy's applicableForFrontend becomes its rule's ruleType (DEFAULT or APPLICABLE_FOR_FRONTEND), and the upload's query parameter applicableForFrontend sets that ruleType as well. Each simplified policy allows READ when resource.a is y and carries rsqlPredicate a==\"y\": read-a-y true and a filter with the predicate if the policy takes part in the backend's decisions, false and DENY if not. Rules of a set with ruleType APPLICABLE_FOR_FRONTEND, DEFAULT, or text that is neither: an ALLOW rule answers true when it applies, a DENY rule under PERMIT_UNLESS_DENY false. The upload golden says whether the PAP stores a ruleType it does not know. Customizations set a rule's ruleType the same way.",
 "resourceTypePrefix": "PARITY_SUITE_R29FD_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "r29fields-frontend-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ],
     "status": "ACTIVE"
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r29",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "r29fields-frontend-body-true",
   "about": "applicableForFrontend true in the body, no query parameter. True and the predicate if the flag changes nothing; false and DENY if a policy for the user interface is left out.",
   "condition": "resource.a == 'y'",
   "policy": {
    "rsqlPredicate": "a==\"y\"",
    "applicableForFrontend": true
   },
   "requests": [
    {
     "name": "read-a-y",
     "resource": {
      "id": "r29",
      "a": "y"
     }
    },
    {
     "name": "read-a-n",
     "resource": {
      "id": "r29",
      "a": "n"
     }
    },
    {
     "name": "filter",
     "filter": true,
     "operation": "READ"
    }
   ]
  },
