{
 "about": "One grant whose region holds the value \"r1 \", with a trailing space. An iterating set allows when region CONTAINS 'r1'. True if the value is trimmed.",
 "resourceTypePrefix": "PARITY_SUITE_R29D_",
 "pins": {
  "/api/v1/permission-scope/user/00000000-0000-0000-0000-000000000101/policies": {
   "statusCode": 200,
   "body": {
    "permissionScope": [
     {
      "id": "00000000-0000-0000-0000-000000000101",
      "isInherited": false,
      "name": "parity-reader",
      "type": "USER",
      "policies": [
       {
        "scopeItems": [
         {
          "key": "region",
          "values": [
           {
            "id": "r1 "
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  }
 },
 "pips": {
  "scope": {
   "name": "subject.permissionScope",
   "pipType": "PERMISSION_SCOPE",
   "url": "http://pip-mock:8090",
   "cacheable": false,
   "cachePeriod": 1
  }
 },
 "cases": [
  {
   "id": "r29doc-scope-value-with-a-space",
   "about": "Iterate over one grant region: [\"r1 \"].",
   "pips": [
    "scope"
   ],
   "sets": [
    {
     "key": "s",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "p",
       "target": "true",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "r",
         "target": "true",
         "condition": "subject.permissionScope.region CONTAINS 'r1' OR resource.a == 'y'",
         "effect": "ALLOW"
        }
       ]
      }
     ],
     "iterate": {
      "foreach": "subject.permissionScope",
      "algorithm": "DENY_UNLESS_PERMIT"
     }
    }
   ],
   "requests": [
    {
     "name": "a-n",
     "resource": {
      "id": "r29doc",
      "a": "n"
     }
    },
    {
     "name": "a-y",
     "resource": {
      "id": "r29doc",
      "a": "y"
     }
    }
   ]
  }
 ]
}
