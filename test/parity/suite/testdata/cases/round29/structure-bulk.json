{
 "about": "POST /access/v1/check/resource/bulk/operations (case field bulkOperations, round 29) and /check/resource/bulk (case field bulk) with and without userId. The golden of a bulk request is its status and the allowed ids, sorted; of a bulk operations request its status and, per operation, the allowed ids, sorted. The expected answer for an operation that no item allows is an empty list. The on-behalf cases repeat the check/resource cases of structure-on-behalf.json with bulk requests: no authorization set, then one that authorizes the M2M client, then one that authorizes the reader.",
 "resourceTypePrefix": "PARITY_SUITE_R29ST_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "r29structure-bulk-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r29",
      "c": "n"
     }
    }
   ]
  },
