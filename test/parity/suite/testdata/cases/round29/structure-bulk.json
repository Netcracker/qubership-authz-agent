   "id": "r29structure-bulkops-per-operation",
   "about": "A set lets the reader READ anything and UPDATE when resource.b == 'v' OR resource.a == 'y'. Three items: a = y with READ, UPDATE, DELETE; a = n with READ, UPDATE; an item of another type with READ. Expected: READ [i-a-n, i-a-y], UPDATE [i-a-y], DELETE [] (the key is absent if the service omits an operation no item allows); the M2M client and an anonymous request: every list empty.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "read",
         "target": "operation == 'READ'",
         "condition": "true",
         "effect": "ALLOW"
        },
        {
         "key": "upd",
         "target": "operation == 'UPDATE'",
         "condition": "resource.b == 'v' OR resource.a == 'y'",
         "effect": "ALLOW"
        }
       ]
      }
     ]
    }
   ],
