      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "rule",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "rsqlPredicate": "a==v",
          "sqlPredicate": "a='v'",
          "predicate": "${resourceType}.a.eq(\"v\")",
          "mongodbPredicate": "{ \"a\": { \"$eq\": \"v\" } }"
         }
        }
       ]
      }
     ]
    }
   ],
