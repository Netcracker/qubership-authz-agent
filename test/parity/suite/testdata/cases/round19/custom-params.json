{
 "about": "The parameters of a customPredicate in check/filter, written with text around the placeholder name; the filter answer shows which name each parameter resolves to.",
 "resourceTypePrefix": "PARITY_SUITE_R19P_",
 "pins": {},
 "pips": {},
 "cases": [
  {
   "id": "a19-custom-param-0",
   "about": "A customPredicate parameter written as 'subject.id'. Control: the bare name.",
   "sets": [
    {
     "key": "s",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "p",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "rules": [
        {
         "key": "r",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "customPredicate": {
           "params": {
            "p": "subject.id"
           },
           "predicate": "[{\"value\":${p},\"property\":\"a\",\"operator\":\"in\"}]"
          }
         }
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true
    }
   ]
  },
