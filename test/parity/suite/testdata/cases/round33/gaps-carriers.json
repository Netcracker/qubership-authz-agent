   "cacheable": false,
   "cachePeriod": 1
  }
 },
 "cases": [
  {
   "id": "r33gaps-carriers-control-first",
   "about": "Control: a DENY rule over a resource attribute that does not hold. True unless the stand answers every check with 400.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "PERMIT_UNLESS_DENY",
     "policies": [
      {
       "key": "reader",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "PERMIT_UNLESS_DENY",
       "rules": [
        {
         "key": "deny",
         "target": "true",
         "condition": "resource.c == 'zz'",
         "effect": "DENY"
        }
       ]
      }
     ]
    }
   ],
   "requests": [
    {
     "name": "read",
     "resource": {
      "id": "r33",
      "c": "n"
     }
    }
   ]
  },
  {
   "id": "r33gaps-jp-number-against-the-text-5-0",
   "about": "The filter compares the number 5 in the resource with the text literal '5.0': the direction round 32 did not ask (r32gaps-number-against-the-same-number-otherwise compared the text 5.0 in the resource with the number literal 5). False for a = n if the two compare as texts, true if as numbers.",
   "condition": "resource.l[?(@.k == '5.0')].id CONTAINS 'a' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r33",
      "a": "n",
      "l": [
       {
        "id": "a",
        "k": 5
       }
      ]
     }
    },
    {
     "name": "read-a-y",
     "resource": {
      "id": "r33",
      "a": "y",
      "l": [
       {
        "id": "a",
        "k": 5
       }
      ]
     }
    }
   ]
  },
  {
   "id": "r33gaps-jp-number-against-the-text-5",
   "about": "The filter compares the number 5 in the resource with the text literal '5'. True for a = n if the two compare as texts or as numbers, false if a number never equals a text.",
   "condition": "resource.l[?(@.k == '5')].id CONTAINS 'a' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r33",
      "a": "n",
      "l": [
       {
        "id": "a",
        "k": 5
       }
      ]
