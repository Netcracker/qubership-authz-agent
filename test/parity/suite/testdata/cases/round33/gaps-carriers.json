  },
  "/api/v1/permission-scope/user/00000000-0000-0000-0000-000000000101/policies": {
   "statusCode": 200,
   "body": {
    "permissionScope": [
     {
      "id": "00000000-0000-0000-0000-000000000101",
      "isInherited": false,
      "name": "parity-reader",
      "type": "USER",
      "policies": [
       {
        "scopeItems": [
         {
          "key": "region",
          "values": [
           {
            "id": "r1"
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  }
 },
 "pips": {
