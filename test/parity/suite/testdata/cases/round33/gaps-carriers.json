   "httpMethod": "POST",
   "cacheable": false,
   "url": "http://pip-mock:8090/api/v1/pip/r33gaps-v",
   "requestAttributes": {
    "case": "r33gaps-sources",
    "t": "${tenant}",
    "c": "${PARITY_R33_CONST}",
    "n": "x-${requestId}"
   }
  },
  "no-attributes": {
   "name": "subject.parityR33NoAttributes",
