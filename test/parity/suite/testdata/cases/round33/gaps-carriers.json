  {
   "id": "r33gaps-mongo-group-of-three-in-an-iterate-pass",
   "pips": [
    "scope"
   ],
   "about": "One grant. As r32gaps-mongo-group-in-an-iterate-pass, with three DENY rules (d, e, g) instead of two: the pass gives the AND of the three negated predicates, and f. mongodbFilterCondition loses the $and of the first group if the splice holds for any group of several predicates.",
   "sets": [
    {
     "key": "set",
     "target": "resourceType == '{{resourceType}}'",
     "algorithm": "DENY_UNLESS_PERMIT",
     "policies": [
      {
       "key": "deny",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_OVERRIDES",
       "rules": [
        {
         "key": "deny-d",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "mongodbPredicate": "{ \"d\": \"1\" }"
         }
        },
        {
         "key": "deny-e",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "mongodbPredicate": "{ \"e\": \"2\" }"
         }
        },
        {
         "key": "deny-g",
         "target": "true",
         "condition": "true",
         "effect": "DENY",
         "predicates": {
          "mongodbPredicate": "{ \"g\": \"4\" }"
         }
        },
        {
         "key": "allow",
         "target": "operation == 'LIST'",
         "condition": "true",
         "effect": "ALLOW"
        }
       ]
      },
      {
       "key": "allow",
       "target": "subject.roles CONTAINS 'ROLE_PARITY_READER'",
       "algorithm": "DENY_UNLESS_PERMIT",
       "rules": [
        {
         "key": "allow-f",
         "target": "true",
         "condition": "true",
         "effect": "ALLOW",
         "predicates": {
          "mongodbPredicate": "{ \"f\": \"3\" }"
         }
        }
       ]
      }
     ],
     "iterate": {
      "foreach": "subject.permissionScope",
      "algorithm": "DENY_UNLESS_PERMIT"
     }
    }
   ],
   "requests": [
    {
     "name": "filter",
     "filter": true,
     "operation": "LIST"
    }
   ]
  },
