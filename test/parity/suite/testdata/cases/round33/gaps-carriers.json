   "pips": [
    "no-attributes"
   ],
   "about": "The PIP declares pipType GENERAL, httpMethod POST, cacheable and url, and no requestAttributes. pipCalls records the body: requestAttributes null, as for the PIPs without pipType of round 32, or {}.",
   "condition": "subject.parityR33NoAttributes == 'v' OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r33",
      "a": "n"
     },
     "pipCalls": "/api/v1/pip/r33gaps-v"
    },
