   "pips": [
    "bean"
   ],
   "condition": "subject.parityR33Bean IS NULL OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
     "resource": {
      "id": "r33",
      "a": "n"
     }
    },
    {
     "name": "read-a-y",
     "resource": {
      "id": "r33",
      "a": "y"
     }
    }
   ]
  },
  {
   "id": "r33gaps-typed-bean-is-empty",
   "about": "The same PIP under IS EMPTY. Both requests false if the PIP gives null (IS EMPTY over null ends the rule, as for a null resource value), true if its value is the empty list.",
   "pips": [
    "bean"
   ],
   "condition": "subject.parityR33Bean IS EMPTY OR resource.a == 'y'",
   "requests": [
    {
     "name": "read-a-n",
