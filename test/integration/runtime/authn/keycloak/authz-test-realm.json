{
  "realm": "authz-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "ROLE_ADMINISTRATOR",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ROLE_ORDER_MANAGEMENT_RO_USER",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ROLE_CANT_READ_ORDERS",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "authz-agent",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "authz-agent-secret",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "authz-agent-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "authz-agent",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "authz-agent-expired",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "authz-agent-expired-secret",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "5"
      },
      "protocolMappers": [
        {
          "name": "authz-agent-expired-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "authz-agent",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "order-reader",
      "email": "order-reader@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Order",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["ROLE_ORDER_MANAGEMENT_RO_USER"]
    },
    {
      "username": "cant-read-orders",
      "email": "cro@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Not an Order",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["ROLE_CANT_READ_ORDERS"]
    },
    {
      "username": "admin",
      "email": "admin@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["ROLE_ADMINISTRATOR"]
    }
  ]
}
