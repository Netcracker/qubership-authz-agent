    {
      "name": "5. DENY Reason Scenarios (PIP failure / missing attr)",
      "item": [
        {
          "name": "PIP resolution failure (expected false)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "{{admin_bearer}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PIP_FAIL_TEST\",\n  \"operation\": \"READ\",\n  \"resource\": {\"ownerId\": \"X\"}\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/check/resource?tenant_id={{tenant_id}}",
            "description": "PIP for brokenPip fails, so the answer is false; the decision log records a reason containing 'PIP resolution failed: brokenPip'. Requires the broken PIP to be uploaded first."
          },
          "response": []
        },
        {
          "name": "Missing subject attribute (expected false)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "{{admin_bearer}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ATTR_MISS_TEST\",\n  \"operation\": \"READ\",\n  \"resource\": {\"ownerId\": \"X\"}\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/check/resource?tenant_id={{tenant_id}}",
            "description": "The policy reads subject.nonExistentAttr, so the answer is false; the decision log records a reason containing 'subject attribute not found: nonExistentAttr'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Predicate Substitution",
      "item": [
        {
          "name": "Subject attribute substitution (PUBLIC_DOC/READ, rsqlFilterCondition subjectId==<id>)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the filter uses a condition', function () {",
                  "  pm.expect(pm.response.json().calculationResult).to.eql('USE_FILTER_CONDITION');",
                  "});",
                  "pm.test('rsqlFilterCondition has the substituted subject.id', function () {",
                  "  const rsql = pm.response.json().rsqlFilterCondition || '';",
                  "  pm.expect(rsql).to.match(/^subjectId==./);",
                  "  pm.expect(rsql).to.not.include('${subject.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "{{admin_bearer}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/check/filter?resourceType=PUBLIC_DOC&operation=READ&tenant_id={{tenant_id}}",
            "description": "rsqlFilterCondition is subjectId== followed by the id in the admin token: the policy's ${subject.id} is substituted."
          },
          "response": []
        },
        {
          "name": "PIP value resolution (CUSTOMER/READ, allowedCustomers called)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "{{admin_bearer}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/check/filter?resourceType=CUSTOMER&operation=READ&tenant_id={{tenant_id}}",
            "description": "Calls the allowedCustomers PIP on the pip-stub; the decision log records its response. Requires the PIP config uploaded beforehand."
          },
          "response": []
        }
      ]
    },
