    {
      "name": "2. Legacy /access/v1/check/resource",
      "item": [
        {
          "name": "Authorization header (order-reader)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "{{order_reader_bearer}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ORDER\",\n  \"operation\": \"READ\",\n  \"resource\": {\n    \"id\": \"order-1\",\n    \"ownerId\": \"order-reader-1\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/check/resource?tenant_id={{tenant_id}}"
          },
          "response": []
        },
        {
          "name": "Authorization header (admin, ALLOW)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "{{admin_bearer}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ATTACHMENT\",\n  \"operation\": \"READ\",\n  \"resource\": {}\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/check/resource?tenant_id={{tenant_id}}"
          },
          "response": []
        },
        {
          "name": "Incoming-Token ignored (Authorization used, expected success)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Incoming-Token", "value": "Bearer expired-token-ignored"},
              {"key": "Authorization", "value": "{{order_reader_bearer}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ORDER\",\n  \"operation\": \"READ\",\n  \"resource\": {\n    \"id\": \"order-1\",\n    \"ownerId\": \"order-reader-1\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/check/resource?tenant_id={{tenant_id}}",
            "description": "Incoming-Token is silently ignored; only Authorization is used"
          },
          "response": []
        },
        {
          "name": "No token (expected 401)",
          "request": {
            "method": "POST",
            "header": [
