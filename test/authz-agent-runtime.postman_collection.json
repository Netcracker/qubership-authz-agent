    {
      "name": "1. Canonical /access/v1/authorize",
      "item": [
        {
          "name": "ORDER READ, ignoreRls=false (order-reader, expected DENY)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{order_reader_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"ORDER\",\n        \"operation\": \"READ\",\n        \"resource\": {\n          \"id\": \"order-1\",\n          \"ownerId\": \"order-reader-1\"\n        }\n      }\n    ],\n    \"subject\": \"{{order_reader_bearer}}\",\n    \"ignoreRls\": false\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "ADR-0062: canonical body is wrapped in {\"input\": ...} and carries authorizationToken in the body (NOT the HTTP Authorization header)."
          },
          "response": []
        },
        {
          "name": "PUBLIC_DOC READ, ignoreRls omitted (admin, expected ALLOW)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{admin_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"PUBLIC_DOC\",\n        \"operation\": \"READ\"\n      }\n    ],\n    \"subject\": \"{{admin_bearer}}\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize"
          },
          "response": []
        },
        {
          "name": "ORDER READ, ignoreRls=true (order-reader, OLS-only)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{order_reader_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"ORDER\",\n        \"operation\": \"READ\",\n        \"resource\": {\n          \"id\": \"order-1\",\n          \"ownerId\": \"order-reader-1\"\n        }\n      }\n    ],\n    \"subject\": \"{{order_reader_bearer}}\",\n    \"ignoreRls\": true\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize"
          },
          "response": []
        },
        {
          "name": "Multi-resource order preserved",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{order_reader_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"ORDER\",\n        \"operation\": \"READ\"\n      },\n      {\n        \"resourceType\": \"ATTACHMENT\",\n        \"operation\": \"READ\"\n      }\n    ],\n    \"subject\": \"{{order_reader_bearer}}\",\n    \"ignoreRls\": false\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize"
          },
          "response": []
        },
        {
          "name": "Missing admission token (expected 200 with result.authError)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"ORDER\",\n        \"operation\": \"READ\"\n      }\n    ],\n    \"subject\": \"\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "ADR-0062 Decision 11 admission failure: empty body.authorizationToken → HTTP 200 with result.authError.{status: 401, reason: \"Authorization token is missing\"} (not a 4xx; the OPA Data API always answers 200). (Pre-ADR-0062 this was signalled by a missing HTTP Authorization header.)"
          },
          "response": []
        },
        {
          "name": "Invalid admission token (expected 200 with result.authError)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"Bearer invalid.jwt.token\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"ORDER\",\n        \"operation\": \"READ\"\n      }\n    ],\n    \"subject\": \"{{order_reader_bearer}}\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "ADR-0062 Decision 11 admission failure: invalid body.authorizationToken → HTTP 200 with result.authError.{status: 401, reason: \"Token is not a valid JWT\"} (not a 4xx; the OPA Data API always answers 200)."
          },
          "response": []
        },
        {
          "name": "Valid admission token, invalid subject (expected 200 DENY with reason)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{admin_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"ORDER\",\n        \"operation\": \"READ\"\n      }\n    ],\n    \"subject\": \"Bearer invalid.jwt.token\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "Admission passes (valid body.authorizationToken), subject invalid → 200 with decision=DENY and reason in each result."
          },
          "response": []
        }
      ]
    },
