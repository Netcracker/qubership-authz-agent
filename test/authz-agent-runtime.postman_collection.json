{
  "info": {
    "_postman_id": "c4a8a215-4d43-40c7-a2ae-b2f7b930fc3f",
    "name": "Authz Agent Runtime (kind port-forward)",
    "description": "Collection for the runtime stack on kind (make e2e), reached through port-forwards as described in docs/local-integration-tests.md. Includes token acquisition, the check routes of the access-control API (v1, v2, and preview), `/api-version`, and requests to removed routes, which expect 404.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Get Token (order-reader)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set(\"order_reader_access_token\", json.access_token || \"\");",
                  "pm.environment.set(\"order_reader_bearer\", json.access_token ? `Bearer ${json.access_token}` : \"\");",
                  "pm.test(\"access_token present\", function () {",
                  "  pm.expect(json.access_token).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{keycloak_scope}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{order_reader_username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{user_password}}",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloak_client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{keycloak_client_secret}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{keycloak_base_url}}/protocol/openid-connect/token",
            "description": "Password-grant token for order-reader user."
          },
          "response": []
        },
        {
          "name": "Get Token (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set(\"admin_access_token\", json.access_token || \"\");",
                  "pm.environment.set(\"admin_bearer\", json.access_token ? `Bearer ${json.access_token}` : \"\");",
                  "pm.test(\"access_token present\", function () {",
                  "  pm.expect(json.access_token).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
