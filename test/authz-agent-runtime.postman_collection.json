    {
      "name": "5. DENY Reason Scenarios (PIP failure / missing attr)",
      "item": [
        {
          "name": "PIP resolution failure (expected DENY with reason)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{admin_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"PIP_FAIL_TEST\",\n        \"operation\": \"READ\",\n        \"resource\": {\"ownerId\": \"X\"}\n      }\n    ],\n    \"subject\": \"{{admin_bearer}}\",\n    \"ignoreRls\": false\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "PIP for brokenPip fails → DENY with reason containing 'PIP resolution failed: brokenPip'. Requires broken PIP to be uploaded first."
          },
          "response": []
        },
        {
          "name": "Missing subject attribute (expected DENY with reason)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{admin_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [\n      {\n        \"resourceType\": \"ATTR_MISS_TEST\",\n        \"operation\": \"READ\",\n        \"resource\": {\"ownerId\": \"X\"}\n      }\n    ],\n    \"subject\": \"{{admin_bearer}}\",\n    \"ignoreRls\": false\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "Policy references subject.nonExistentAttr which is not a PIP and not in JWT → DENY with reason containing 'subject attribute not found: nonExistentAttr'"
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Predicate Substitution",
      "item": [
        {
          "name": "Subject attribute substitution (PUBLIC_DOC/READ → subjectId resolved)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('decision is ALLOW', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.result.results[0].decision).to.eql('ALLOW');",
                  "});",
                  "pm.test('rlsPredicate has substituted subject.id', function () {",
                  "  const pred = pm.response.json().result.results[0].rlsPredicate || '';",
                  "  pm.expect(pred).to.match(/^subjectId==/);",
                  "  pm.expect(pred).to.not.include('${subject.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{admin_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [{\"resourceType\": \"PUBLIC_DOC\", \"operation\": \"READ\"}],\n    \"subject\": \"{{admin_bearer}}\",\n    \"ignoreRls\": false\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "Verifies that ${subject.id} in predicate is substituted with actual JWT sub claim value."
          },
          "response": []
        },
        {
          "name": "PIP value substitution (CUSTOMER/READ → allowedCustomers resolved)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('decision is ALLOW', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.result.results[0].decision).to.eql('ALLOW');",
                  "});",
                  "pm.test('rlsPredicate has substituted PIP value', function () {",
                  "  const pred = pm.response.json().result.results[0].rlsPredicate || '';",
                  "  pm.expect(pred).to.eql('customerId=in=(C1,C2,C3)');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"authorizationToken\": \"{{admin_bearer}}\",\n    \"authorizationType\": \"\",\n    \"requestHeaders\": {},\n    \"resources\": [{\"resourceType\": \"CUSTOMER\", \"operation\": \"READ\"}],\n    \"subject\": \"{{admin_bearer}}\",\n    \"ignoreRls\": false\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{authz_base_url}}/access/v1/authorize",
            "description": "Verifies that ${subject.allowedCustomers} in predicate is substituted with PIP-resolved value from pip-stub (C1,C2,C3). Requires PIP config uploaded beforehand."
          },
          "response": []
        }
      ]
    },
