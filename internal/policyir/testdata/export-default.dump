set "18cc872e-fe1b-271e-c1c0-10ae26521369" name="config-export iterating" domain="" algorithm=DENY_UNLESS_PERMIT externalId="parity-config-export-iterating"
  target[set_target]: resourceType EQ "PARITY_SUITE_REG_CONFIG_EXPORT"
  iterate var="iterate1" algorithm=DENY_UNLESS_PERMIT
  policy "5d7f6022-91f4-e843-35d8-70429993ac9f" name="config-export scoped" algorithm=DENY_UNLESS_PERMIT
    target[policy_target]: subject.roles CONTAINS "ROLE_PARITY_READER"
    rule "fd0e6283-1aa9-c2f7-4225-f270f4c618a7" name="config-export region-granted" effect=ALLOW
      target[rule_target]: operation EQ "READ"
      condition[rule_condition]: pass("iterate1")["region"] CONTAINS resource.region
set "29d30093-46d9-6451-f124-47bc4403a4e9" name="config-export plain" domain="" algorithm=DENY_UNLESS_PERMIT externalId="parity-config-export-plain"
  target[set_target]: resourceType EQ "PARITY_SUITE_REG_CONFIG_EXPORT"
  policy "3ed8a456-2feb-be77-3a84-7cf4b9d0b0bb" name="config-export reader" algorithm=DENY_UNLESS_PERMIT
    target[policy_target]: subject.roles CONTAINS "ROLE_PARITY_READER"
    rule "9f94d4a5-b4ed-dcf4-78db-fddfa7065f0c" name="config-export read-deny-when-n" effect=DENY
      target[rule_target]: operation EQ "READ"
      condition[rule_condition]: resource.a EQ "n"
    rule "0ad3f6a0-dd3d-3593-de27-26b06d3270e9" name="config-export list-with-every-predicate" effect=ALLOW
      target[rule_target]: operation EQ "LIST"
      condition[rule_condition]: TRUE
      predicate rsql "a==${subject.id}"
      predicate sql "a=${subject.id}"
      predicate mongodb "{ \"a\": \"${subject.id}\" }"
      predicate querydsl "${resourceType}.a.eq(\"${subject.id}\")"
      customPredicate "[{\"value\":${owner},\"property\":\"a\",\"operator\":\"in\"}]" params={"owner": "subject.id"}
    rule "c117ba8f-710c-f333-e37e-2be01bc20717" name="config-export read-allow" effect=ALLOW
      target[rule_target]: operation EQ "READ"
      condition[rule_condition]: TRUE
