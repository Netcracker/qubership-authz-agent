  Resolves the class path Run.java runs on for the differential test of
  internal/jsonpath. `make test-jayway` writes it with
  dependency:build-classpath; nothing is built from this file.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.qubership.authz</groupId>
  <artifactId>jsonpath-jayway-harness</artifactId>
  <version>0</version>
  <packaging>pom</packaging>

  <dependencies>
    <!-- One of the versions legacy access-control evaluates its paths with;
         renovate.json keeps it. -->
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>2.9.0</version>
    </dependency>
    <!-- Run.java reads the document with Jackson, numbers with a fraction as
         BigDecimal. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
    </plugins>
  </build>
</project>
