    {
      "policySetId": "b5460ede-bc45-49d7-8465-a4302bb50f58",
      "name": "PolicySet for checking access to resource with GREATER THAN or LESS THAN operators",
      "target": "resourceType == 'CompareOperators'",
      "status": "ACTIVE",
      "combiningAlgorithm": "DENY_UNLESS_PERMIT",
      "tenantId": "default",
      "policies": [
        {
          "policyId": "1f855cc5-0d2a-41c6-8b81-582594ff1876",
          "name": "Policy for checking access to resource with GREATER THAN operator",
          "combiningAlgorithm": "DENY_UNLESS_PERMIT",
          "tenantId": "default",
          "rules": [
            {
              "ruleId": "6b04e0b8-bd16-45e2-b6c7-d0e2ccaae491",
              "name": "Policy for checking access to resource with GREATER THAN operator",
              "target": "operation == 'GREATER_THAN'",
              "condition": "resource.price GREATER THAN 10.1 AND resource.price > 10.2",
              "tenantId": "default",
              "effect": "ALLOW"
            },
            {
              "ruleId": "9becf7c6-5b35-4e78-a75a-55e90c53d0a5",
              "name": "Policy for checking access to resource with GREATER THAN sign operator",
              "target": "operation == 'GREATER_THAN_OR_EQUAL_TO'",
              "condition": "resource.price GREATER THAN OR EQUAL TO 10.0 AND resource.price >= 10",
              "tenantId": "default",
              "effect": "ALLOW"
            },
            {
              "ruleId": "316afc6f-0a7d-4c93-a202-1e79b2144774",
              "name": "Policy for checking access to resource with LESS THAN operator",
              "target": "operation == 'LESS_THAN'",
              "condition": "resource.price LESS THAN 100.0 AND resource.price < 100",
              "tenantId": "default",
              "effect": "ALLOW"
            },
            {
              "ruleId": "bdc9c06e-8390-4702-8d0a-d75000549053",
              "name": "Policy for checking access to resource with LESS THAN OR EQUAL TO operator",
              "target": "operation == 'LESS_THAN_OR_EQUAL_TO'",
              "condition": "resource.price LESS THAN OR EQUAL TO 100.0 AND resource.price <= 100",
              "tenantId": "default",
              "effect": "ALLOW"
            },
            {
              "ruleId": "b9f7e430-eada-4b9e-a646-9527165eacbc",
              "name": "Policy for checking access to resource with LESS THAN and GREATER THAN operator",
              "target": "operation == 'LESS_THAN_AND_GREATER_THAN'",
              "condition": "resource.price LESS THAN OR EQUAL TO 100 OR resource.price GREATER THAN OR EQUAL TO 10.1",
              "tenantId": "default",
              "effect": "ALLOW"
            },
            {
              "ruleId": "146a6a16-484a-4103-8e19-5d47431e1955",
              "name": "Policy for checking access to resource with LESS THAN and GREATER THAN operator",
              "target": "operation == 'LESS_THAN_AND_GREATER_THAN_WITH_NEGATIVE'",
              "condition": "resource.price LESS THAN OR EQUAL TO 100.1 OR resource.price GREATER THAN OR EQUAL TO -10.1",
              "tenantId": "default",
              "effect": "ALLOW"
            }
          ]
        }
      ]
    },
    {
