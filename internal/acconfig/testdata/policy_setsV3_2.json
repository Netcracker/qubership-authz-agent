          "tenantId": "default",
          "rules": [
            {
              "ruleId": "78dc6daa-f491-4580-86f3-a02988abf60a",
              "name": "Rule with data from map field in resource",
              "tenantId": "default",
              "target": "operation == 'GettingFromMapBasedResourceAttr'",
              "condition": "resource.mapBasedResourceAttr.firstMapBasedResourceAttr EQUALS 'ItIsMapBasedResourceAttr'",
              "effect": "ALLOW"
            },
            {
              "ruleId": "78dc6daa-f491-4580-86f3-a02988abf60a",
              "name": "Rule with predicates",
              "tenantId": "default",
              "target": "resourceType == 'Lead'",
              "condition": "resource.customerId IN subject.getCustomerIds",
              "effect": "ALLOW",
              "predicate": "${resourceType}.resource.customerId.in(${subject.getCustomerIds})",
              "sqlPredicate": "resource.customerId IN (${subject.getCustomerIds})",
              "rsqlPredicate": "resource.customerId=in=(${subject.getCustomerIds})",
              "mongodbPredicate": "\"resource.customerId\":{\"$in\":${subject.getCustomerIds}}"
            }
          ]
        }
      ]
