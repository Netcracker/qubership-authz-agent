# Settings of authz-agent for compose.yaml. Every line holds the default of its
# variable, except the lines whose comment names another value. An empty value
# of a number, of true or false, or of a level takes the default.

# Level of the platform logger: debug, info, warn, error, or fatal.
LOGGING_LEVEL_ROOT=info

# The M2M mode. Outside Kubernetes only legacy works. The agent does not read
# this variable yet.
M2M_AUTH_MODE=legacy

# Whether the agent sends a projected Kubernetes token, true, or gets its own
# token with client credentials, false, as it has to outside Kubernetes. The
# agent does not read this variable yet: AUTHZ_M2M_TOKEN_URL alone chooses.
KUBERNETES_M2M_ENABLED=false

# Listen addresses of the public surface and of the internal one, which serves
# /health, /ready, /api-version, and /prometheus. compose.yaml repeats these
# ports under ports and in the healthcheck URL; change them there too.
AUTHZ_PUBLIC_ADDR=0.0.0.0:8080
AUTHZ_HTTP_ADDR=0.0.0.0:8181

# The trusted providers file; empty runs without providers.
AUTHZ_TRUSTED_PROVIDERS_FILE=/etc/authz/trusted-providers.json
# true: every provider has to have its keys before the agent is ready; false:
# one provider is enough, as long as every provider marked required has keys.
AUTHZ_JWKS_BOOTSTRAP_REQUIRED=true
# Seconds per discovery or JWKS request, at least 1.
AUTHZ_JWKS_HTTP_TIMEOUT=5
# Attempts per request, at least 1.
AUTHZ_JWKS_HTTP_RETRIES=3
# Seconds between checks of the providers file for a change; 0 never reloads.
AUTHZ_TRUSTED_PROVIDERS_RELOAD_INTERVAL=30
# Base URL of tenant-manager, which resolves a realm named by a tenant's display
# name; empty turns the lookup off.
AUTHZ_TENANT_MANAGER_URL=

# Base URL of the policy source; empty turns the pull off, and the agent then
# serves without policies.
AUTHZ_PAP_CLIENT_SOURCE_URL=
# Seconds between pulls; 0 turns the pull off.
AUTHZ_PAP_CLIENT_PULL_INTERVAL=30

# Base URL of the entitlements PIP that the installation pins; empty adds none.
AUTHZ_ENTITLEMENTS_URL=
# Seconds per entitlements request, at least 1.
AUTHZ_ENTITLEMENTS_HTTP_TIMEOUT=5
# Attempts per entitlements request, at least 1.
AUTHZ_ENTITLEMENTS_HTTP_RETRIES=3

# Token endpoint where the agent gets its own token with client credentials.
# The default is empty, and the agent then reads AUTHZ_PAP_CLIENT_TOKEN_FILE,
# which no container outside Kubernetes has. Replace this example with the
# endpoint of the cloud-common realm of the installation.
AUTHZ_M2M_TOKEN_URL=https://keycloak.example.com/auth/realms/cloud-common/protocol/openid-connect/token
# Files with the client id and the client secret of the agent, which
# compose.yaml mounts from ./secret.
AUTHZ_M2M_CLIENT_ID_FILE=/etc/secret/username
AUTHZ_M2M_CLIENT_SECRET_FILE=/etc/secret/password
# Seconds before its expiry at which the token is renewed, at least 0.
AUTHZ_M2M_RENEW_BEFORE_SECONDS=60
# The projected Kubernetes token, which the agent reads, every 15 seconds,
# when AUTHZ_M2M_TOKEN_URL is empty.
AUTHZ_PAP_CLIENT_TOKEN_FILE=/var/run/secrets/tokens/netcracker/token

# Read by the entrypoint of the image: seconds between SIGTERM and its delivery
# to the agent. The default, 10, gives a Kubernetes Service time to stop
# routing requests to a Pod; under Docker nothing has to, so this example sets
# 0. stop_grace_period in compose.yaml has to exceed this delay by more than
# the 10 seconds the agent takes to stop.
SIGTERM_EXIT_DELAY=0
