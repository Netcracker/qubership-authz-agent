# Settings of authz-agent for compose.yaml. Every line holds the default of its
# variable, except the lines whose comment names another value. An empty value
# of a number, of true or false, of a level, or of a listen address takes the
# default.

# Level of the platform logger: debug, info, warn, error, or fatal.
LOGGING_LEVEL_ROOT=info

# The M2M mode, which decides the kinds of token the agent accepts in
# Authorization. Outside Kubernetes only legacy works: it accepts the tokens of
# the providers in authz/trusted-providers.json and no Kubernetes service
# account token. The agent does not read this variable yet.
M2M_AUTH_MODE=legacy

# The token the agent sends: true sends the projected Kubernetes token in
# AUTHZ_PAP_CLIENT_TOKEN_FILE, and false gets the token of its realm from
# AUTHZ_M2M_TOKEN_URL with client credentials. Outside Kubernetes only false
# works.
KUBERNETES_M2M_ENABLED=false

# Listen addresses of the public surface, which serves the check routes the
# clients call, and of the internal one, which serves /health, /ready,
# /api-version, and /prometheus. compose.yaml repeats these ports under ports
# and in the healthcheck URL; change them there too.
AUTHZ_PUBLIC_ADDR=0.0.0.0:8080
AUTHZ_HTTP_ADDR=0.0.0.0:8181

# The trusted providers file. Empty runs without providers: no token verifies,
# and the agent waits for no keys before it is ready.
AUTHZ_TRUSTED_PROVIDERS_FILE=/etc/authz/trusted-providers.json
# true: every provider has to have its keys before the agent is ready; false:
# one provider is enough, as long as every provider marked required has keys.
AUTHZ_JWKS_BOOTSTRAP_REQUIRED=true
# Seconds per discovery or JWKS request, at least 1.
AUTHZ_JWKS_HTTP_TIMEOUT=5
# Attempts per request, at least 1.
AUTHZ_JWKS_HTTP_RETRIES=3
# Seconds between checks of the providers file for a change; 0 never reloads.
AUTHZ_TRUSTED_PROVIDERS_RELOAD_INTERVAL=30
# Base URL of tenant-manager, which resolves a realm named by a tenant's display
# name; empty turns the lookup off.
AUTHZ_TENANT_MANAGER_URL=

# Base URL of the policy source. The default is empty, which turns the pull
# off, and the agent is then ready without policies. Replace this example with
# the base URL of the policy source of the installation.
AUTHZ_PAP_CLIENT_SOURCE_URL=https://policy-source.example.com
# Seconds between pulls; 0 turns the pull off.
AUTHZ_PAP_CLIENT_PULL_INTERVAL=30

# Base URL of the entitlements PIP, which does not come with the policies the
# agent pulls. Empty adds none, and policies that read entitledResources then
# see an empty set without a log line, so set it wherever such policies are in
# use.
AUTHZ_ENTITLEMENTS_URL=
# Seconds per entitlements request, at least 1.
AUTHZ_ENTITLEMENTS_HTTP_TIMEOUT=5
# At least 1. The agent sends each entitlements request once, whatever the
# value.
AUTHZ_ENTITLEMENTS_HTTP_RETRIES=3

# Token endpoint where the agent gets its own token with client credentials.
# The default is empty, and KUBERNETES_M2M_ENABLED=false then stops the start.
# Replace this example with the endpoint of the cloud-common realm of the
# installation.
AUTHZ_M2M_TOKEN_URL=https://keycloak.example.com/auth/realms/cloud-common/protocol/openid-connect/token
# Files with the client id and the client secret of the agent, which
# compose.yaml mounts from ./secret.
AUTHZ_M2M_CLIENT_ID_FILE=/etc/secret/username
AUTHZ_M2M_CLIENT_SECRET_FILE=/etc/secret/password
# Seconds before its expiry at which the token is renewed, at least 0. The
# renewal comes no earlier than half the lifetime of the token.
AUTHZ_M2M_RENEW_BEFORE_SECONDS=60
# The projected Kubernetes token, which the agent reads every 15 seconds with
# KUBERNETES_M2M_ENABLED=true and never with false.
AUTHZ_PAP_CLIENT_TOKEN_FILE=/var/run/secrets/tokens/netcracker/token

# Read by the entrypoint of the image: seconds between SIGTERM and its delivery
# to the agent. The default, 10, gives a Kubernetes Service time to stop
# routing requests to a Pod. Under Docker nothing has to stop routing first, so
# this example sets 0. stop_grace_period in compose.yaml has to exceed this
# delay by more than the 10 seconds that the agent takes at most to stop.
SIGTERM_EXIT_DELAY=0
