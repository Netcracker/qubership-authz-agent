# Go binaries
/components/*/bin/
*.test
*.out

# Go build cache and temp
/tmp/

# Parity suite: *.observed.json sidecar output from local runs (not evidence)
*.observed.json

# Go workspace sum database
go.work.sum

# IDE/editor artifacts
.idea/
.vscode/
*.swp
*~
/test/artifacts/

# SVT load-test scenarios, regenerated by test/svt/scripts/build-per-scenario-jmx.py
/test/svt/load-tests/
__pycache__/
# SVT run artifacts
/test/svt/artifacts/

# APM dependencies
apm_modules/

# Class path make test-jayway resolves, and the agent make jayway-suite-calls builds
/internal/jsonpath/testdata/jayway/target/
/internal/jsonpath/testdata/jayway/recorder/target/

# The realm and stub files of the test-stand chart, generated by
# `make test-stand-files` (build/authz-agent-transfer/Dockerfile, stage chart-files).
/helm-templates/authz-test-stand/files/

# The reports mutago writes into the root, which make mutation-diff moves to
# test/artifacts/mutation/ after the run
/mutago-agentic.json
/mutago-summary.json
