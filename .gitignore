# Go binaries
/components/*/bin/
*.test
*.out
test/tools/opa/opa

# Go build cache and temp
/tmp/

# Generated Rego staging area for the Helm chart.
# Source of truth: policies/
# Generate with: make copy-policies
/charts/authz-agent/files/opa/policies/

# Runtime test configs (rendered by test/scripts/render-runtime-configs.sh)
/test/.runtime-configs/

# Parity suite: *.observed.json sidecar output from local runs (not evidence)
*.observed.json

# OPA binary (installed by test/scripts/install-opa.sh)
/test/tools/opa/opa

# Go workspace sum database
go.work.sum

# IDE/editor artifacts
.idea/
.vscode/
*.swp
*~
/test/artifacts/

# SVT profiler RSA keypair — generated at runtime by
# test/svt/profiler/keys/setup-real-token.py before the first benchmark run.
# The private key is ephemeral and must not be committed.
/test/svt/profiler/keys/profiler-rsa-private.pem
/test/svt/profiler/keys/profiler-rsa-public.pem
# Derived profiler fixtures — regenerated by test/svt/profiler/keys/setup-real-token.py
test/svt/profiler/**/data-real-token.json
test/svt/profiler/**/input-real-token.json
