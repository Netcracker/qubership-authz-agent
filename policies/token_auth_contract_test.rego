package token_auth_contract_test

import rego.v1

fixtures := data.fixtures.identity
idp_provider_fixture := fixtures.authn.trustedProviders.byId["test-idp"]

policies_fixture := {
  "ols": {
    "CUSTOMER": {
      "READ": ["ROLE_VIEWER"]
    }
  },
  "rls": {
    "CUSTOMER": {
      "READ": {
        "ROLE_VIEWER": [
          {
            "condition": true,
            "predicates": [
              {
                "predicate": "true",
                "type": "rsql"
              }
            ]
          }
        ]
      }
    }
  }
}

runtime_policies_fixture := {
  "ols": {
    "ORDER": {
      "READ": ["ROLE_ADMINISTRATOR", "ROLE_ORDER_MANAGEMENT_RO_USER"]
    }
  },
  "rls": {
    "ORDER": {
      "READ": {
        "ROLE_ADMINISTRATOR": [
          {
            "condition": true,
            "predicates": [
              {
                "predicate": "true",
                "type": "rsql"
              }
            ]
          }
        ],
        "ROLE_ORDER_MANAGEMENT_RO_USER": [
          {
            "conditionAst": {
              "op": "eq",
              "args": [
                {
                  "ref": {
                    "scope": "resource",
                    "path": ["ownerId"]
                  }
                },
                {
                  "ref": {
                    "scope": "subject",
                    "path": ["id"]
                  }
                }
              ]
            },
            "predicates": [
              {
                "predicate": "ownerId==${subject.id}",
                "type": "rsql"
              }
            ]
          }
        ]
      }
    }
  }
}

test_token_auth_valid_user_allows_authorize if {
  token := sprintf("Bearer %v", [fixtures.tokens.valid])
  input_req := {
    "resources": [
      {
        "resourceType": "Customer",
        "operation": "READ",
        "resource": {
          "id": "cust-1"
        }
      }
    ],
    "subject": token,
    "ignoreRls": true
  }

  actual := data.authorize
    with input as input_req
    with data.authn as fixtures.authn
    with data.policies as policies_fixture

  actual.rlsIgnored == true
  count(actual.results) == 1
  actual.results[0].isAllowed == true
}

test_token_auth_service_token_subject_type if {
  token := sprintf("Bearer %v", [fixtures.tokens.service])
  auth := data.identity.authenticate({"subject": token}) with data.authn as fixtures.authn
  auth.authenticated
  auth.subject.type == "SERVICE"
}

test_token_auth_naked_subject_token_is_rejected if {
  auth := data.identity.authenticate({"subject": fixtures.tokens.valid}) with data.authn as fixtures.authn
  not auth.authenticated
  auth.error.reasonCode == "TOKEN_SCHEME_INVALID"
}

# The published `data.authn` document is the only supported shape since
# authz-agent-ADR-0075: providers keyed by id, keys keyed by kid. The fixture is
# generated by tests/scripts/token-testkit/refresh-rego-fixtures.sh in exactly
# the layout pap-client writes, so this asserts the contract between the two.
test_token_auth_published_authn_shape_is_supported if {
  token := sprintf("Bearer %v", [fixtures.tokens.valid])

  auth := data.identity.authenticate({"subject": token}) with data.authn as fixtures.authn

  auth.authenticated
  auth.subject.id == "user-allow"
  idp_provider_fixture.required == true
}

test_token_auth_runtime_data_layout_allows_legacy_check_resource if {
  token := sprintf("Bearer %v", [fixtures.tokens.orderReader])
  runtime_authn := fixtures.authn

  input_req := {
    "resources": [{"resourceType": "ORDER", "operation": "READ", "resource": {"id": "order-1", "ownerId": "order-reader-1"}}],
    "subject": token,
    "ignoreRls": true,
  }

  actual := data.authorize
    with input as input_req
    with data.authn as runtime_authn
    with data.policies as runtime_policies_fixture

  actual.results[0].isAllowed == true
}

test_token_auth_verified_tokens_cache_entry_is_trusted_fast_path if {
  cached_token := "cached-token-direct"
  cached_authn := {
    "verifiedTokens": {
      cached_token: {
        "providerId": "cached-idp",
        "subject": {
          "id": "cached-user",
          "name": "cached-user",
          "type": "USER",
          "roles": ["ROLE_VIEWER"],
          "scopes": ["openid"]
        },
        "payload": {
          "sub": "cached-user",
          "preferred_username": "cached-user",
          "realm_access": {
            "roles": ["ROLE_VIEWER"]
          }
        }
      }
    }
  }

  auth := data.identity.authenticate({"subject": sprintf("Bearer %v", [cached_token])}) with data.authn as cached_authn

  auth.authenticated
  auth.subject.id == "cached-user"
  auth.subject.roles == ["ROLE_VIEWER"]
  object.get(auth.subject, "permissions", "__missing__") == "__missing__"
}

test_token_auth_verified_tokens_cache_can_fall_back_to_payload_subject if {
  cached_token := "cached-token-payload-only"
  cached_authn := {
    "verifiedTokens": {
      cached_token: {
        "providerId": "cached-idp",
        "payload": {
          "sub": "payload-user",
          "preferred_username": "payload-user",
          "realm_access": {
            "roles": ["ROLE_VIEWER"]
          },
          "scope": "openid profile"
        }
      }
    }
  }

  auth := data.identity.authenticate({"subject": sprintf("Bearer %v", [cached_token])}) with data.authn as cached_authn

  auth.authenticated
  auth.subject.id == "payload-user"
  auth.subject.name == "payload-user"
  auth.subject.roles == ["ROLE_VIEWER"]
  auth.subject.scopes == ["openid", "profile"]
  object.get(auth.subject, "permissions", "__missing__") == "__missing__"
}

# ── Canonical: no authorizationToken -> subject invalid -> 200 DENY ───────

test_token_auth_missing_token_canonical_deny if {
  input_req := {
    "resources": [
      {
        "resourceType": "Customer",
        "operation": "READ",
        "resource": {}
      }
    ],
    "subject": "",
    "ignoreRls": true
  }

  actual := data.authorize
    with input as input_req
    with data.authn as fixtures.authn
    with data.policies as policies_fixture

  not object.get(actual, "authError", false)
  count(actual.results) == 1
  actual.results[0].isAllowed == false
  actual.results[0].reason == "Authorization token is missing"
}

test_token_auth_expired_canonical_deny if {
