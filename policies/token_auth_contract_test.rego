# ── realm_access.roles positive cases ────────────────────────────────────

test_token_auth_realm_access_roles_are_used if {
  payload := {
    "realm_access": {
      "roles": ["ROLE_VIEWER", "ROLE_EDITOR"]
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 2
  roles[0] == "ROLE_EDITOR"
  roles[1] == "ROLE_VIEWER"
}

test_token_auth_realm_access_roles_are_case_normalized if {
  payload := {
    "realm_access": {
      "roles": ["role_viewer", "Role_Editor"]
    }
  }
  roles := data.identity.payload_roles(payload)
  count(roles) == 2
  roles[0] == "ROLE_EDITOR"
  roles[1] == "ROLE_VIEWER"
}

