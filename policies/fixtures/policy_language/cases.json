        "condition": "resource.serviceCharacteristic[?(@.name=='singleValuedData')].value.organization.customer-email CONTAINS ANY 'email1@testmail.netcracker.com'",
        "rsqlPredicate": "jsonpath=email_filter"
      }
    }
  }
}
